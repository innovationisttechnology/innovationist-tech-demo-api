# Application
APP_NAME="Innovationist Tech Demo API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8181

# Comma-separated origins allowed to call the API (the demo UI).
# Optional — if unset, defaults to http://localhost:3001 in development and
# https://demo.innovationisttech.com in production. Set explicitly to override.
# Origins are scheme+host+port only (no trailing slash/path).
# CORS_ORIGINS="http://localhost:3001,https://demo.innovationisttech.com"

# MongoDB — optional. Set to enable database features.
# MONGO_URI="mongodb://localhost:27017"
# MONGO_DB_NAME="innovationist_demo"

# docker-compose only: root credentials for the bundled mongo/mongo-express.
# Defaults to admin/adminpassword if unset.
# MONGO_ROOT_USER="admin"
# MONGO_ROOT_PASSWORD="adminpassword"

# ziza-ai (pydantic-ai) — provider key required to call the /api/ziza endpoints.
# Read directly by pydantic-ai from the environment.
# ANTHROPIC_API_KEY="sk-ant-..."

# ziza-ai model overrides (optional). Format: "<provider>:<model>".
# Defaults: chat -> anthropic:claude-sonnet-4-5, classifier -> anthropic:claude-haiku-4-5
# ZIZA_CHAT_MODEL="anthropic:claude-sonnet-4-5"
# ZIZA_CLASSIFIER_MODEL="anthropic:claude-haiku-4-5"

# Optional Tavily key for the ziza-ai web_search tool; stubbed when unset.
# TAVILY_API_KEY="tvly-..."

# ziza-ai vector store: local fastembed (ONNX) model for knowledge-base
# embeddings. Downloaded once into the HF cache on first use.
# EMBEDDING_MODEL_ID="BAAI/bge-small-en-v1.5"
